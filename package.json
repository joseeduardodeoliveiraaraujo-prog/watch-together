{
  "name": "watch-together",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.24",
    "expo-constants": "~58.0.16",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "format": "prettier --write .",
    "build:player": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-player-page.mjs",
    "check:player": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-player-page.mjs --check",
    "deploy:player": "npm run build:player && npx vercel@latest deploy web/player --prod",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:player"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "private": true
}
