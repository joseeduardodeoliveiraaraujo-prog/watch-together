# Copie para .env.local e preencha.
# Variáveis EXPO_PUBLIC_* são embutidas no app e, portanto, PÚBLICAS.
# NUNCA coloque a chave service_role/secret do Supabase aqui.

# Página do player publicada na Vercel (web/player). Precisa ser https.
EXPO_PUBLIC_PLAYER_URL=https://watch-together-player.vercel.app/

# Etapa 3 — use apenas a chave publishable/anon; a segurança vem das políticas RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
