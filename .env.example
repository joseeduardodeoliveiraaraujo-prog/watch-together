# Copie para .env.local e preencha (Etapa 3).
# Variáveis EXPO_PUBLIC_* são embutidas no app e, portanto, PÚBLICAS.
# Use apenas a chave publishable/anon — a segurança vem das políticas RLS.
# NUNCA coloque a chave service_role/secret aqui.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
